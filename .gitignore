# macOS
.DS_Store

# Local Claude Code state (per-user IDE artifacts)
.claude/

# ---------------------------------------------------------------------
# Unity (groundwork/) — auto-generated, regenerated by Editor
# ---------------------------------------------------------------------
groundwork/[Ll]ibrary/
groundwork/[Tt]emp/
groundwork/[Oo]bj/
groundwork/[Ll]ogs/
groundwork/[Mm]emoryCaptures/
groundwork/[Pp]rofilerCaptures/
groundwork/[Rr]ecordings/
groundwork/[Bb]uild/
groundwork/[Bb]uilds/
groundwork/[Uu]ser[Ss]ettings/

# Unity-generated IDE project files (regenerated from the .meta / asmdef state)
groundwork/*.csproj
groundwork/*.unityproj
groundwork/*.sln
groundwork/*.suo
groundwork/*.user
groundwork/*.userprefs
groundwork/*.pidb
groundwork/*.booproj
groundwork/*.svd
groundwork/*.pdb
groundwork/*.mdb
groundwork/*.opendb
groundwork/*.VC.db
groundwork/*.tmp
groundwork/sysinfo.txt

# Build outputs
groundwork/*.apk
groundwork/*.aab
groundwork/*.app
groundwork/*.unitypackage
groundwork/crashlytics-build.properties

# Runtime-generated state (regenerated every Play session — noisy diffs)
groundwork/NetworkAutosave.json
groundwork/TerrainAutosave.json
groundwork/TerrainPacks.json
groundwork/TuningOverrides.json
groundwork/TerrainTuningOverrides.json

# Mono/Unity crash dumps
mono_crash.*

# Third-party asset packs — kept LOCAL, not committed (personal-use only)
groundwork/Assets/BrokenVector/
groundwork/Assets/BrokenVector.meta
groundwork/Assets/YughuesFreeRockMaterials/
groundwork/Assets/YughuesFreeRockMaterials.meta
# Reorganized local asset folders (third-party packs moved here — keep local)
groundwork/Assets/Trees/
groundwork/Assets/Trees.meta
groundwork/Assets/Rocks/
groundwork/Assets/Rocks.meta
groundwork/Assets/Vehicles/
groundwork/Assets/Vehicles.meta
groundwork/Assets/Signs/
groundwork/Assets/Signs.meta
groundwork/Assets/Textures/
groundwork/Assets/Textures.meta
groundwork/Assets/TerrainLayer.terrainlayer
groundwork/Assets/TerrainLayer.terrainlayer.meta
groundwork/Assets/Cliffs/
groundwork/Assets/Cliffs.meta
groundwork/Assets/Fences/
groundwork/Assets/Fences.meta
groundwork/Assets/Bridges/
groundwork/Assets/Bridges.meta
groundwork/Assets/HQP STUDIOS/
groundwork/Assets/HQP STUDIOS.meta
groundwork/Assets/SkyBox/
groundwork/Assets/SkyBox.meta
groundwork/Assets/Completed Packages/
groundwork/Assets/Completed Packages.meta
groundwork/Assets/Shaders/LowPolyShaders/
groundwork/Assets/Shaders/LowPolyShaders.meta
# Heightmap input image (kept local)
groundwork/terrain1.png

# Common stray .meta files for ignored dirs (Unity emits these)
groundwork/[Ll]ibrary.meta
groundwork/[Tt]emp.meta
groundwork/[Oo]bj.meta
groundwork/[Ll]ogs.meta
groundwork/[Bb]uild.meta
groundwork/[Bb]uilds.meta
groundwork/[Uu]ser[Ss]ettings.meta

# ---------------------------------------------------------------------
# Node / Vite (road-designer/) — see road-designer/.gitignore too
# ---------------------------------------------------------------------
road-designer/node_modules/
road-designer/dist/
road-designer/.vite/
road-designer/*.log

# Purchased asset pack (1,000+ icons) — kept out of the repo for now (unused until
# the 3D-prefab cursor is built). Remove this line to start tracking it.
groundwork/Assets/icons/

# Worlds — one folder per world (Worlds/<name>/): DEM tiles, world/game manifest, object
# autosave AND sculpt edits, all together. Large + per-machine (re-download as needed).
groundwork/Worlds/

# Purchased Unity environment pack (Rocky Hills + Toby Foliage Engine) — 2.3GB,
# re-importable from the Asset Store, kept out of git.
groundwork/Assets/Toby Fredson/

# Purchased Unity tree pack (Greenworks Mountain Forest) — 1.5GB, re-importable
# from the Asset Store (import its -URP unitypackage). The conifer prefabs copied
# into Resources/Trees reference it by GUID, so they ride along, kept out of git.
groundwork/Assets/Mountain Forest/
groundwork/Assets/Mountain Forest.meta
groundwork/Assets/Resources/Trees/Conifer*.prefab*
groundwork/Assets/Resources/Trees/Juniper*.prefab*
# Tree/foliage prefabs copied from the gitignored NatureManufacture / Mountain Forest packs into Resources.
groundwork/Assets/Resources/Trees/Beech Trees/
groundwork/Assets/Resources/Trees/Beech Trees.meta
groundwork/Assets/Resources/Trees/Trees/
groundwork/Assets/Resources/Trees/Trees.meta

# Purchased Unity ground-texture pack (NatureManufacture Landscape Ground Pack) — re-importable from the
# Asset Store, kept out of git.
groundwork/Assets/NatureManufacture Assets/
groundwork/Assets/NatureManufacture Assets.meta

# Terrain ground textures copied (from the gitignored packs) into Resources for the TerrainGround shader —
# large + re-derivable; the shader falls back to tint colours when they're absent.
groundwork/Assets/Resources/TerrainGround/
groundwork/Assets/Resources/TerrainGround.meta

# Runtime per-chunk sculpt saves (chunk-streaming test)
groundwork/ChunkEdits/
groundwork/ChunkEditsDem/

# Local backups (e.g. road-config.json.bak)
*.bak
