# ---------------------------------------------------------------------
# Node / Vite (road-designer/) — see road-designer/.gitignore too
# ---------------------------------------------------------------------
road-designer/node_modules/
road-designer/dist/
road-designer/.vite/
road-designer/*.log

# Purchased asset pack (1,000+ icons) — kept out of the repo for now (unused until
# the 3D-prefab cursor is built). Remove this line to start tracking it.
network-designer/Assets/icons/

# Large, regenerable DEM heightmap/albedo sets (downloaded per-machine).
# Albedo mosaics are 200MB+ each — over GitHub's 100MB limit. Keep the data
# out of git; only the per-city norm memory is tracked (re-download tiles as needed).
network-designer/Assets/Heightmaps/Highres/*
!network-designer/Assets/Heightmaps/Highres/dem_norms.txt

# Purchased Unity environment pack (Rocky Hills + Toby Foliage Engine) — 2.3GB,
# re-importable from the Asset Store, kept out of git.
network-designer/Assets/Toby Fredson/

# Purchased Unity tree pack (Greenworks Mountain Forest) — 1.5GB, re-importable
# from the Asset Store (import its -URP unitypackage). The conifer prefabs copied
# into Resources/Trees reference it by GUID, so they ride along, kept out of git.
network-designer/Assets/Mountain Forest/
network-designer/Assets/Mountain Forest.meta
network-designer/Assets/Resources/Trees/Conifer*.prefab*
network-designer/Assets/Resources/Trees/Juniper*.prefab*

# Runtime per-chunk sculpt saves (chunk-streaming test)
network-designer/ChunkEdits/
network-designer/ChunkEditsDem/

# Saved games (per-game folders: manifest + autosave + chunk edits)
network-designer/Games/
